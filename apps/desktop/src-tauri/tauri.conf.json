{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PCL Linux",
  "version": "0.2.0",
  "identifier": "dev.pcl-linux.experimental",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PCL Linux · 原生实验版",
        "width": 1000,
        "height": 650,
        "minWidth": 810,
        "minHeight": 500,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:"
    }
  },
  "bundle": { "active": false, "icon": ["../../../assets/pcl-linux.png"] }
}
